---
const footerLinks = {
  product: [
    { label: "Features", href: "#features" },
    { label: "Download", href: "/Shuuchuu-Setup.exe" },
    { label: "Release Notes", href: "#" },
    { label: "Roadmap", href: "#" },
  ],
  support: [
    { label: "Help Center", href: "#" },
    { label: "Contact", href: "#" },
    { label: "Bug Report", href: "#" },
  ],
  legal: [
    { label: "Privacy Policy", href: "#" },
    { label: "Terms of Service", href: "#" },
  ],
};

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/app-icon.png" alt="Shuuchuu Logo" class="logo-icon-img" />
          <span class="logo-text">Shuuchuu</span>
        </a>
        <p class="footer-tagline">
          Built by Thamaraiselvan, a Computer Science Engineering student
          passionate about building cross-platform applications (Desktop, Mobile
          & Web). Shuuchuu is my project to master flows and conquer goals.
        </p>
        <div class="footer-social">
          <!-- LinkedIn -->
          <a
            href="https://linkedin.com/in/thamarai-selvan-15765a2a2"
            target="_blank"
            class="social-link"
            aria-label="LinkedIn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
          </a>
          <!-- GitHub -->
          <a
            href="https://github.com/Thamaraiselvan10"
            target="_blank"
            class="social-link"
            aria-label="GitHub"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links Column -->
      <div class="footer-links-group">
        <h4 class="footer-heading">Product</h4>
        <ul class="footer-links">
          {
            footerLinks.product.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact Column -->
      <div class="footer-links-group" style="grid-column: span 2;">
        <h4 class="footer-heading">Contribute & Contact</h4>
        <div class="contact-info">
          <p class="contact-desc">
            Interested in contributing? Reach out directly!
          </p>
          <a href="mailto:thamaraiselvanvcb@gmail.com" class="contact-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            thamaraiselvanvcb@gmail.com
          </a>
          <a href="tel:9698958735" class="contact-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            +91 9698958735
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} Shuuchuu. Built with 💜 for focus enthusiasts.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  /* Brand */
  .footer-brand {
    max-width: 300px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: var(--space-md);
  }

  .logo-icon-img {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    object-fit: contain;
  }

  .footer-logo .logo-text {
    background: linear-gradient(
      135deg,
      var(--primary-color),
      var(--secondary-color)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-lg);
    line-height: 1.6;
  }

  /* Social Links */
  .footer-social {
    display: flex;
    gap: var(--space-md);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition: all var(--transition-fast);
  }

  .social-link:hover {
    background: var(--nav-hover-bg);
    border-color: var(--primary-color);
    color: var(--primary-color);
    transform: translateY(-2px);
  }

  /* Link Groups */
  .footer-heading {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-color);
    margin-bottom: var(--space-lg);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--transition-fast);
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--primary-color);
  }

  /* Contact Section */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-color);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .contact-link:hover {
    color: var(--primary-color);
  }

  .contact-link svg {
    color: var(--primary-color);
  }

  /* Bottom Bar */
  .footer-bottom {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-color);
  }

  .copyright {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
      max-width: none;
      text-align: center;
      margin-bottom: var(--space-lg);
    }

    .footer-social {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-links-group {
      margin-bottom: var(--space-lg);
    }
  }
</style>
